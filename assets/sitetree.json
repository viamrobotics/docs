{{- /*
  /sitetree.json: the full site IA as JSON, for agents (linked from
  llms.txt). Mirrors the core child-selection logic of
  layouts/partials/sidebar-tree.html (this repo's own override of the
  docsy theme's version -- that's the file actually in force), so this
  matches the real sidebar rather than an independent notion of structure.
  See CLAUDE.md's "Agent discoverability files" section for the full
  system, including why this is generated via Hugo Pipes rather than a
  Hugo output format.

  Recurses via a named template that emits JSON text directly (each
  string value individually escaped with `jsonify`), rather than a
  recursive `partial` returning a Go value, matching how sidebar-tree.html
  itself recurses.

  Schema: a node's "path" key is present only when the node has real
  content of its own. A pure-signpost section (Hugo's manualLink /
  manualLinkRelref frontmatter) omits "path" and carries "redirect"
  instead, pointing at the real page a human ends up at. This lets a
  consumer tell "real content, safe to fetch" apart from "redirect stub,
  don't bother" by field presence alone, and avoids the same URL
  appearing twice in the tree (once as a section, once as its own
  "Overview" child).
*/ -}}
{{- template "sitetree-node" . -}}
{{- define "sitetree-node" -}}
{{- $s := . -}}
{{- $isRedirect := or (isset $s.Params "manuallink") (isset $s.Params "manuallinkrelref") -}}
{{- $redirectTarget := cond (isset $s.Params "manuallink") ($s.Params.manualLink | absURL) (cond (isset $s.Params "manuallinkrelref") ((relref $s $s.Params.manualLinkRelref) | absURL) "") -}}
{{- $children := where (union $s.Pages $s.Sections).ByWeight ".Params.toc_hide" "!=" true -}}
{ "title": {{ $s.LinkTitle | jsonify }}{{ if $isRedirect }}, "redirect": {{ $redirectTarget | jsonify }}{{ else }}, "path": {{ $s.Permalink | jsonify }}{{ end }}{{ with $s.Params.description }}, "description": {{ . | jsonify }}{{ end }}{{ if gt (len $children) 0 }}, "children": [{{ range $i, $c := $children }}{{ if $i }},{{ end }}{{ template "sitetree-node" $c }}{{ end }}]{{ end }} }
{{- end -}}
